<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.showremote.demo" android:versionCode="7" android:versionName="0.6-beta">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="LifeSHOW" android:icon="@drawable/lifeshow_icon" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
